#!/usr/bin/python
from argparse import *
import os
import glob
import platform
from datetime import date

today = date.today()

print("Today's date:", today)

parser = ArgumentParser()

parser.add_argument('--num_proc'        , type=int, help='N_p       ',default='4')
parser.add_argument('--max_taylor_order', type=int, help='P_max     ',default='4')
parser.add_argument('--max_weight_power', type=int, help='W_max     ',default='3')
parser.add_argument('--domain_bc'       , type=str, help='dom BC    ',default="dirichlet")
parser.add_argument('--eb_bc'           , type=str, help='EB BC     ',default="dirichlet")
parser.add_argument('--prefix'          , type=str, help='test name ',default= "all_regular_2d")
parser.add_argument('--input'           , type=str, help='input file',default="_input_templates/all_regular.inputs")
parser.add_argument('--batch'           , type=str, help='batch file',default="_batch_templates/spencer.batch")
parser.add_argument('--petsc'           , type=str, help='petsc file',default="_batch_templates/dot.petscrc")

args = parser.parse_args()
print(args)
homestr = os.getcwd();
neartopstr = homestr + "/_" +args.prefix
strtoday =str(today.month) + "_" + str(today.day) + "_" + str(today.year)
print ("homedir = " + homestr)

compile_dir = ".."
exec_name_str = "main.exe"
dot_petsc = ".petscrc"
exec_file_str =  compile_dir + "/" + exec_name_str
petsc_file_str =  compile_dir + "/" + dot_petsc
if not os.path.exists(petsc_file_str):
  print(petsc_file_str + " does not exist.   Huh.")
  exit()
    
if not os.path.exists(exec_file_str):
  print(exec_file_str + " does not exist.   Compiling.")
  comm_str = "cd " + compile_dir  + "; make -j16 ;  cd -; "
  print(comm_str)
  os.system(comm_str)
  
if not os.path.exists(exec_file_str):
  print(exec_file_str + "still does not exist.   Huh. Guess compilation failed.")
  exit()
  

domain_bc= args.domain_bc
eb_bc    = args.eb_bc
topstr = neartopstr +"_" + strtoday
print ("topstr = " + topstr)
execstr = exec_file_str
if not os.path.exists(topstr):
    printstr = "making directory " + topstr
    print (printstr)
    os.mkdir(topstr)
    commstr = "cp " + execstr + " " + topstr;
    print(commstr);
    os.system(commstr);

print ("changing directory to " + topstr)
os.chdir(topstr);

submitstr = "submit."  + args.prefix + ".jobs"
r = open(submitstr,'w')
r.write('#!/usr/bin/csh\n')

max_taylor = args.max_taylor_order
max_weight = args.max_weight_power

submitstr = "submit."  + args.prefix + ".jobs"
subfile = open(submitstr,'w')
subfile.write('#!/usr/bin/csh \n \n')
inputfilebase = os.path.basename(args.input)
batchfilebase = os.path.basename(args.batch)
petscfilebase = os.path.basename(args.petsc)
execfilebase = exec_name_str
inputtemplatename = homestr + "/" + args.input
batchtemplatename = homestr + "/" + args.batch
petsctemplatename = homestr + "/" + args.petsc

num_proc = args.num_proc
taylor_P = 2
while taylor_P <= max_taylor:
    weight_P = 1
    while weight_P <= max_weight:
      max_neig_rad  = 3
      neig_rad = 1
      while neig_rad <= max_neig_rad:

        f_inputtemplate = open(inputtemplatename,'r')
        f_batchtemplate = open(batchtemplatename,'r')
        
        configstr = "_Tay" + str(taylor_P) + "_Wgt_" + str(weight_P) + "_Np_" + str(num_proc) + "_Nrad_" + str(neig_rad)
        print (configstr);

        print ("changing directory to " + topstr)
        os.chdir(topstr);
        dir_str = configstr
        
        batchfilename = batchfilebase 
        commstr = "cd " + dir_str  + "; source " + batchfilename + "; cd .. "
        echostr = "echo \" " + commstr + " \" \n"
        subfile.write(echostr)
        subfile.write(commstr + "\n")

        if not os.path.exists(dir_str):
            printstr = "making directory " + dir_str
            print (printstr)
            os.mkdir(dir_str)
        
        print ("changing directory to " + dir_str)
        os.chdir(dir_str)
        print ("copying petsc init file")
        full_petsc = petsctemplatename
        commstr = " cp " + full_petsc + " ./.petscrc "
        print (commstr)
        os.system(commstr)

        inputfilename = inputfilebase 
        print ("processing input file " + inputfilename)
        f_inp = open(inputfilename,'w')
        
        for inputstr in f_inputtemplate:
            t1str = inputstr;
            t2str = t1str.replace("TAYLOR_MAX", str(taylor_P))
            t3str = t2str.replace("WGT_POWER",  str(weight_P))
            t4str = t3str.replace("DOMAIN_FACE_BC",  domain_bc)
            t5str = t4str.replace("CUT_FACE_BC",  eb_bc)
            t6str = t5str.replace("NEIGH_RAD",str(neig_rad))
            f_inp.write(t6str)
        
        f_inp.close()
        
        print ("processing batch file " + batchfilename)
        f_bat = open(batchfilename,'w')
        for batchstr in f_batchtemplate:
            t1str = batchstr
            t2str = t1str.replace("INPUT_FILE", inputfilename)
            exec_name = "../"+ execfilebase
            t3str = t2str.replace("EXECUTABLE_FILE", exec_name)
            t4str = t3str.replace("NUM_NODE", str(num_proc))
            f_bat.write(t4str)

        f_bat.close()
        f_inputtemplate.close()
        f_batchtemplate.close()
        neig_rad += 1
#       end neig_rad loop
      weight_P +=  1
#     end weight_p loop
    taylor_P += 1
#   end outer scope

print("Closing submission file and making it executable")
subfile.close();
commstr = "cd " + topstr + "; chmod +x  " + submitstr
print (commstr)
os.system(commstr)
print("Let there be peace on Earth and goodwill among men.")

    
